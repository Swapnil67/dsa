    {
      "id": "m64ZWgdM112OikiyBMx9R",
      "type": "text",
      "x": 276.61328125,
      "y": 976.2578125,
      "width": 332.85986328125,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ac",
