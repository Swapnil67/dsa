    {
      "id": "wpD30L55s3-us7FEbuSvu",
      "type": "text",
      "x": 274,
      "y": 775,
      "width": 685.5796508789062,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aZ",
      "roundness": null,
      "seed": 2109622633,
      "version": 193,
      "versionNonce": 1952189289,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792579681220,
      "link": null,
      "locked": false,
      "text": "To go to nth block position we can go from n-1, n-2 ...., n - kth blocks\nSo we need to add all the possible ways from i to i - k.\n\n\nCost to reach ith block = |h[i] - h[j]| and j = i-1, i-2, i-3, ... i-k ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "To go to nth block position we can go from n-1, n-2 ...., n - kth blocks\nSo we need to add all the possible ways from i to i - k.\n\n\nCost to reach ith block = |h[i] - h[j]| and j = i-1, i-2, i-3, ... i-k ",
      "autoResize": true,
      "lineHeight": 1.25
    },
