      "updated": 1792579766817,
      "link": null,
      "locked": false,
      "text": "path = [0, 0, 0, 0, 3, 2, 2, 3, 7, 7]",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "path = [0, 0, 0, 0, 3, 2, 2, 3, 7, 7]",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "RgSoZJv1bXzscG7FoLx-9",
      "type": "text",
      "x": 281.4921875,
      "y": 1020.1328125,
      "width": 435.09967041015625,
      "height": 375,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ae",
      "roundness": null,
      "seed": 240842473,
      "version": 294,
      "versionNonce": 71246249,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792581985268,
      "link": null,
      "locked": false,
      "text": "Pseudo Code\n\ndp[0] = 0\nfor i ... n\n    min_cost = INF\n    j = 1\n    while (j <= k && i - j >= 0) {\n         cur_cost = abs(h[i] - h[i-j]) + dp[i-j]\n         if (min_cost > cur_cost) {\n             min_cost = cur_cost\n             path[i] = i - j\n         }\n    }\n    dp[i] = min_cost\n}",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Pseudo Code\n\ndp[0] = 0\nfor i ... n\n    min_cost = INF\n    j = 1\n    while (j <= k && i - j >= 0) {\n         cur_cost = abs(h[i] - h[i-j]) + dp[i-j]\n         if (min_cost > cur_cost) {\n             min_cost = cur_cost\n             path[i] = i - j\n         }\n    }\n    dp[i] = min_cost\n}",
      "autoResize": true,
      "lineHeight": 1.25
    }
  ],
